rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stores: public read; all writes go through Admin SDK (API / Stripe / cron).
    // Client updates are denied so owners cannot set plan / subscriptionStatus /
    // isActive / ownerId (or inject javascript: URLs) from the browser.
    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if false;

      // Private billing data — server-only, no client access
      match /private/{docId} {
        allow read, write: if false;
      }

      // Billing history — server-only, no client access
      match /billingHistory/{entryId} {
        allow read, write: if false;
      }
    }

    // Coupons: anyone can read active coupons, owner of parent store can write
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/stores/$(resource.data.storeId))
        && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid;
    }

    // Admins: only admin can read their own doc
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only via Firebase console
    }

    // Stripe webhook event dedup — server-only, no client access
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Reviews: anyone can read published reviews; writes go through API only
    match /reviews/{reviewId} {
      allow read: if resource.data.status == "published";
      allow write: if false;
    }
  }
}

